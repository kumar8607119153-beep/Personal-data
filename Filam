# ============================================================
# SCENE PARSER
# ============================================================

def parse_scenes(text):
    pattern = re.compile(
        r"SCENE\s+(\d+)\s+—\s+([^\n]+)",
        re.UNICODE
    )

    scenes = []

    for match in pattern.finditer(text):
        number = int(match.group(1))
        title = match.group(2).strip()

        start = match.start()
        next_match = pattern.search(text, match.end())

        if next_match:
            block = text[start:next_match.start()].strip()
        else:
            block = text[start:].strip()

        scenes.append({
            "scene": number,
            "title": title,
            "text": block,
            "dashboard": number in DASHBOARD_SCENES,
            "phone_number": (
                MOBILE_NUMBER
                if number in PHONE_SCENES
                else None
            ),
        })

    return scenes


SCENES = parse_scenes(MASTER_FILM)


