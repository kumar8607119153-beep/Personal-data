# ============================================================
# DELTA SIGNATURE HELPER
# ============================================================

def delta_signature(
    method,
    timestamp,
    path,
    query_string="",
    body=""
):
    """
    Delta Exchange HMAC helper.

    IMPORTANT:
    API credentials are NEVER printed.
    """

    if not DELTA_API_SECRET:
        raise RuntimeError(
            "DELTA_API_SECRET is not configured."
        )

    message = (
        str(timestamp)
        + method.upper()
        + path
        + query_string
        + body
    )

    return hmac.new(
        DELTA_API_SECRET.encode(),
        message.encode(),
        hashlib.sha256
    ).hexdigest()


