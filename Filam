        )
        print(
            "playwright install chromium"
        )
        return None

    print(
        f"Dashboard found: {dashboard}"
    )

    # --------------------------------------------------------
    # NOTE:
    # We do not fabricate a dashboard.
    # If the existing dashboard is already running locally,
    # capture its actual UI.
    # --------------------------------------------------------

    dashboard_url = os.getenv(
        "SANJAY_RANA_LOCAL_DASHBOARD_URL",
        "http://localhost:8501"
    )

    try:
        with sync_playwright() as p:

            browser = p.chromium.launch(
                headless=True
            )

            page = browser.new_page(
                viewport={
                    "width": 1440,
                    "height": 1000,
                }
            )

            page.goto(
                dashboard_url,
                wait_until="networkidle",
                timeout=60000
            )

            page.screenshot(
                path=str(
                    REAL_DASHBOARD_SCREENSHOT
                ),
                full_page=True
            )

            browser.close()

        print(
            "REAL DASHBOARD CAPTURED:"
        )
        print(
            REAL_DASHBOARD_SCREENSHOT
        )

        return str(
            REAL_DASHBOARD_SCREENSHOT
        )

    except Exception as exc:

        print(
            "Dashboard capture could not be completed:"
        )
        print(exc)

        return None


# ============================================================
# FILM PRODUCTION PACKAGE
# ============================================================

def export_production_package():

    output_dir = Path(
        "SANJAY_RANA_RATHORE_FILM"
    )

    output_dir.mkdir(
        exist_ok=True
    )

    master_path = (
        output_dir /
        "SANJAY_RANA_RATHORE_MASTER_FILM.txt"
    )

    manifest_path = (
        output_dir /
        "film_manifest.json"
    )

    system_path = (
        output_dir /
        "system_config.json"
    )

    master_path.write_text(
        MASTER_FILM.strip()
        + "\n",
        encoding="utf-8"
    )

    manifest = build_manifest()

    manifest_path.write_text(
        json.dumps(
            manifest,
            ensure_ascii=False,
            indent=2
        ),
        encoding="utf-8"
    )

    system_path.write_text(
        json.dumps(
            SYSTEM_RULES,
            ensure_ascii=False,
            indent=2
        ),
        encoding="utf-8"
    )

    return {
        "master": str(master_path),
        "manifest": str(manifest_path),
        "system": str(system_path),
    }


